{
  "id": "acp/set-config-option-model",
  "spec": [
    "13-Session Config Options.md#from-the-client",
    "13-Session Config Options.md#initial-state",
    "13-Session Config Options.md#configoptionvalue",
    "01-Overview.md#error-handling",
    "02-Initialization.md#mcp-capabilities"
  ],
  "description": "Сессия с опциями mode и model (scripted/m1, scripted/m2); клиент меняет model на scripted/m2 и получает ответ с полным снимком всех опций без отдельного config_option_update; затем просит scripted/m9, которого нет в options, и получает ошибку -32602, значение остаётся scripted/m2.",
  "goals": [
    "R-06"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "skipInitialize": true,
    "config": {
      "agent": {
        "default_model": "scripted/m1"
      },
      "providers": {
        "scripted": {
          "models": {
            "m1": {},
            "m2": {}
          }
        }
      }
    }
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "клиент объявляет fs и terminal и запрашивает версию 1",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "initializeId"
        },
        "method": "initialize",
        "params": {
          "$partial": {
            "protocolVersion": 1,
            "clientCapabilities": {
              "fs": {
                "readTextFile": true,
                "writeTextFile": true
              },
              "terminal": true
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ агента — ровно эти поля (agent-core §13.2)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${initializeId}",
        "result": {
          "protocolVersion": 1,
          "agentCapabilities": {
            "loadSession": true,
            "promptCapabilities": {
              "image": true,
              "audio": false,
              "embeddedContext": true
            },
            "mcpCapabilities": {
              "http": false,
              "sse": false
            },
            "sessionCapabilities": {
              "list": {}
            }
          },
          "agentInfo": {
            "name": "codelab-agent",
            "title": "CodeLab Agent",
            "version": {
              "$any": "0.1.0"
            }
          },
          "authMethods": []
        }
      }
    },
    {
      "dir": "c2a",
      "note": "клиент создаёт сессию без MCP-серверов",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "sessionNewId"
        },
        "method": "session/new",
        "params": {
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "note": "режимы для совместимости и configOptions — основной канал (agent-core §13.4)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${sessionNewId}",
        "result": {
          "sessionId": {
            "$capture": "sessionId"
          },
          "modes": {
            "currentModeId": "standard",
            "availableModes": [
              {
                "id": "plan",
                "name": "Plan",
                "description": "Read and plan only, no changes"
              },
              {
                "id": "ask",
                "name": "Ask",
                "description": "Approve every call, including reads"
              },
              {
                "id": "standard",
                "name": "Standard",
                "description": "Reads without asking, edits and commands with approval"
              },
              {
                "id": "accept-edits",
                "name": "Accept edits",
                "description": "Reads and edits without asking, commands and network with approval"
              },
              {
                "id": "bypass",
                "name": "Bypass",
                "description": "No approval except for critical commands, agent config edits and network access"
              }
            ]
          },
          "configOptions": [
            {
              "id": "mode",
              "name": "Mode",
              "category": "mode",
              "type": "select",
              "currentValue": "standard",
              "options": [
                {
                  "value": "plan",
                  "name": "Plan"
                },
                {
                  "value": "ask",
                  "name": "Ask"
                },
                {
                  "value": "standard",
                  "name": "Standard"
                },
                {
                  "value": "accept-edits",
                  "name": "Accept edits"
                },
                {
                  "value": "bypass",
                  "name": "Bypass"
                }
              ]
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/m1",
              "options": [
                {
                  "value": "scripted/m1",
                  "name": "m1"
                },
                {
                  "value": "scripted/m2",
                  "name": "m2"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": {
              "$any": []
            }
          }
        }
      },
      "note": "после ответа session/new (ACP-8); состав списка — фикстуры этапа 8"
    },
    {
      "dir": "c2a",
      "note": "пользователь выбирает модель scripted/m2",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "setModelId"
        },
        "method": "session/set_config_option",
        "params": {
          "sessionId": "${sessionId}",
          "configId": "model",
          "value": "scripted/m2"
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ — полный снимок; config_option_update не дублируется (agent-core §13.6)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${setModelId}",
        "result": {
          "configOptions": [
            {
              "id": "mode",
              "name": "Mode",
              "category": "mode",
              "type": "select",
              "currentValue": "standard",
              "options": [
                {
                  "value": "plan",
                  "name": "Plan"
                },
                {
                  "value": "ask",
                  "name": "Ask"
                },
                {
                  "value": "standard",
                  "name": "Standard"
                },
                {
                  "value": "accept-edits",
                  "name": "Accept edits"
                },
                {
                  "value": "bypass",
                  "name": "Bypass"
                }
              ]
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/m2",
              "options": [
                {
                  "value": "scripted/m1",
                  "name": "m1"
                },
                {
                  "value": "scripted/m2",
                  "name": "m2"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "note": "значения нет в options",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "setUnknownId"
        },
        "method": "session/set_config_option",
        "params": {
          "sessionId": "${sessionId}",
          "configId": "model",
          "value": "scripted/m9"
        }
      }
    },
    {
      "dir": "a2c",
      "note": "неизвестное значение — -32602, состояние не меняется",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${setUnknownId}",
        "error": {
          "code": -32602,
          "message": {
            "$any": "Invalid params"
          }
        }
      }
    }
  ]
}
