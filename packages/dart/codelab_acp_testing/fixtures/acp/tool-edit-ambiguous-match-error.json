{
  "id": "acp/tool-edit-ambiguous-match-error",
  "spec": [
    "08-Tool Calls.md#status",
    "05-Prompt Turn.md#5-tool-invocation-and-status-reporting"
  ],
  "description": "Строка для замены встречается в файле дважды; edit ничего не пишет и завершается failed с текстом ошибки для модели; модель получает результат с ошибкой и отвечает.",
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "bypass",
    "files": {
      "README.md": "foo\nfoo\n"
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "README"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "edit",
              "arguments": {
                "path": "README.md",
                "oldText": "foo",
                "newText": "bar"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": true
          }
        },
        "reply": [
          {
            "text": "Уточню место."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Замени foo на bar в README.md"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "read1"
        },
        "method": "fs/read_text_file",
        "params": {
          "$partial": {
            "sessionId": "${sessionId}",
            "path": "${cwd}/README.md"
          }
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${read1}",
        "result": {
          "content": "foo\nfoo\n"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md"
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "in_progress"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "read2"
        },
        "method": "fs/read_text_file",
        "params": {
          "$partial": {
            "sessionId": "${sessionId}",
            "path": "${cwd}/README.md"
          }
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${read2}",
        "result": {
          "content": "foo\nfoo\n"
        }
      }
    },
    {
      "dir": "a2c",
      "note": "неоднозначная замена — ошибка, а не правка",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "failed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "2"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Уточню место."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ],
  "after": {
    "files": {
      "README.md": "foo\nfoo\n"
    }
  }
}
