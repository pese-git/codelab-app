      "note": "текстов и мыслей потомков в кадрах нет: только ответ корня",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Аудит выполнен: см. отчёт субагента."
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    },
    {
      "dir": "c2a",
      "note": "загрузка той же сессии в том же соединении: реплей открытой сессии из хранилища агента (D47 Т7)",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "loadId"
        },
        "method": "session/load",
        "params": {
          "sessionId": "${sessionId}",
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "note": "реплей: слова пользователя (agent-core §13.5, шаг 5)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "user_message_chunk",
            "content": {
              "type": "text",
              "text": "Проверь авторизацию и тесты"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "вызов agent корня — один tool_call с итоговым статусом, {id, type} и summary (D24, D28)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": "Subagent general: Audit auth",
            "kind": "think",
            "status": "completed",
            "rawInput": {
              "type": "general",
              "description": "Audit auth",
              "prompt": "Read lib/auth.dart, then delegate listing of the tests to an explorer and report both."
            },
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": "Authentication is in lib/auth.dart; its tests are in test/auth_test.dart."
                }
              }
            ],
            "_meta": {
              "codelab": {
                "subagent": {
                  "id": "${subagentId}",
                  "type": "general",
                  "summary": {
                    "toolCalls": 3,
                    "tokens": {
                      "input": 5600,
                      "output": 320
                    },
                    "durationMs": {
                      "$any": 48000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "D47 Т6: сразу после tool_call вызова agent — вызовы ребёнка из его журнала, с итоговыми статусами и теми же toolCallId и parentToolCallId, что вживую",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1/call_1",
            "title": {
              "$contains": "lib/auth.dart"
            },
            "kind": "read",
            "status": "completed",
            "rawInput": {
              "path": "lib/auth.dart"
            },
            "locations": [
              {
                "path": "${cwd}/lib/auth.dart"
              }
            ],
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": "1| void login() {}"
                }
              }
            ],
            "_meta": {
              "codelab": {
                "parentToolCallId": "call_1"
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "вложенный agent: {id, type, summary} внука в одном кадре (D28, D47 Т3)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1/call_2",
            "title": "Subagent explore: List tests",
            "kind": "think",
            "status": "completed",
            "rawInput": {
              "type": "explore",
              "description": "List tests",
              "prompt": "List the files in the test directory."
            },
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": "The test directory contains auth_test.dart."
                }
              }
            ],
            "_meta": {
              "codelab": {
                "parentToolCallId": "call_1",
                "subagent": {
                  "id": "${grandchildId}",
                  "type": "explore",
                  "summary": {
                    "toolCalls": 1,
                    "tokens": {
                      "input": 1600,
                      "output": 150
                    },
                    "durationMs": {
                      "$any": 48000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "реплей рекурсивен: вызовы внука идут после вызова agent ребёнка (глубина до 3)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1/call_2/call_1",
            "title": {
              "$contains": "test"
            },
            "kind": "search",
            "status": "completed",
            "rawInput": {
              "path": "test"
            },
            "locations": [
              {
                "path": "${cwd}/test"
              }
            ],
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "auth_test.dart"
                  }
                }
              }
            ],
            "_meta": {
              "codelab": {
                "parentToolCallId": "call_1/call_2"
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "тексты потомков в реплее не проигрываются",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
