{
  "id": "acp/session-load-subagent-tool-tree",
  "spec": [
    "03-Session Setup.md#loading-a-session",
    "03-Session Setup.md#loading-sessions",
    "08-Tool Calls.md#creating",
    "15-Extensibility.md#the-_meta-field"
  ],
  "description": "Живой ход фикстуры acp/prompt-subagent-tool-tree (ребёнок и внук, клиент объявил subagentToolCalls), затем session/load той же сессии в том же соединении по образцу acp/session-load-replay: агент повторяет историю, и сразу после tool_call вызова agent идут вызовы потомков из их журналов, рекурсивно, с итоговыми статусами и теми же toolCallId и _meta.codelab.parentToolCallId (D47 Т6, Т7). Загрузчик setup.sessions не меняется: журналы с диска новым процессом проверяет тест ядра на JsonlSessionStore. Зеленеет в агентском прогоне после 5.2 и 5.3, в клиентском после 5.4 (change add-subagents-and-tasks, задача 5.1; agent-acp-server «Реплей дерева»; design.md D21, D47 Т6, Т7, Т8).",
  "goals": [
    "C-06"
  ],
  "extensions": [
    "capabilities",
    "subagent",
    "parentToolCallId"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "files": {
      "lib/auth.dart": "void login() {}\n",
      "test/auth_test.dart": "void main() {}\n"
    },
    "clientCapabilities": {
      "fs": {
        "readTextFile": true,
        "writeTextFile": true
      },
      "terminal": true,
      "_meta": {
        "codelab": {
          "tasks": {
            "version": 1
          },
          "subagents": {
            "version": 1
          },
          "subagentToolCalls": {
            "version": 1
          }
        }
      }
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "авторизац"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "agent",
              "arguments": {
                "type": "general",
                "description": "Audit auth",
                "prompt": "Read lib/auth.dart, then delegate listing of the tests to an explorer and report both."
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "systemPrompt": {
            "$textContains": "You are a subagent"
          },
          "lastMessage": {
            "role": "user",
            "$textContains": "Read lib/auth.dart"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "read",
              "arguments": {
                "path": "lib/auth.dart"
              }
            }
          }
        ],
        "stopReason": "toolUse",
        "usage": {
          "input": 1000,
          "output": 40
        }
      },
      {
        "expect": {
          "systemPrompt": {
            "$textContains": "You are a subagent"
          },
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_2",
              "name": "agent",
              "arguments": {
                "type": "explore",
                "description": "List tests",
                "prompt": "List the files in the test directory."
              }
            }
          }
        ],
        "stopReason": "toolUse",
        "usage": {
          "input": 1200,
          "output": 50
        }
      },
      {
        "expect": {
          "systemPrompt": {
            "$textContains": "You are a subagent"
          },
          "lastMessage": {
            "role": "user",
            "$textContains": "List the files"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "ls",
              "arguments": {
                "path": "test"
              }
            }
          }
        ],
        "stopReason": "toolUse",
        "usage": {
          "input": 700,
          "output": 30
        }
      },
      {
        "expect": {
          "systemPrompt": {
            "$textContains": "You are a subagent"
          },
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "The test directory contains auth_test.dart."
          }
        ],
        "stopReason": "stop",
        "usage": {
          "input": 900,
          "output": 120
        }
      },
      {
        "expect": {
          "systemPrompt": {
            "$textContains": "You are a subagent"
          },
          "toolResult": {
            "toolCallId": "call_2",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "Authentication is in lib/auth.dart; its tests are in test/auth_test.dart."
          }
        ],
        "stopReason": "stop",
        "usage": {
          "input": 1800,
          "output": 80
        }
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "Аудит выполнен: см. отчёт субагента."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "пользователь просит проверить авторизацию; модель поручает работу субагенту general",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Проверь авторизацию и тесты"
            }
