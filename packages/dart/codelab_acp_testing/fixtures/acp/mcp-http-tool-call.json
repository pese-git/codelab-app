{
  "id": "acp/mcp-http-tool-call",
  "spec": [
    "03-Session Setup.md#mcp-servers",
    "03-Session Setup.md#http-transport",
    "02-Initialization.md#mcp-capabilities",
    "08-Tool Calls.md#creating",
    "08-Tool Calls.md#requesting-permission",
    "08-Tool Calls.md#status"
  ],
  "description": "session/new присылает HTTP-сервер web (modern), сервер old типа sse и сервер future неизвестного типа websocket; old и future пропущены (mcp.server.skipped), сессия создана, mcp__web__search после одобрения завершается completed. HTTP-сервер идёт через настоящий StreamableHttpTransport (E-03). Адрес сервера в фикстуре — https://<имя>.mcp.test/mcp: фабрика агентского прогона выбирает fake-сервер по первой метке хоста.",
  "goals": [
    "E-03"
  ],
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "skipInitialize": true,
    "mcp": {
      "web": {
        "era": "modern",
        "tools": [
          {
            "name": "search",
            "inputSchema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "query"
              ]
            }
          }
        ],
        "results": {
          "search": {
            "content": [
              {
                "type": "text",
                "text": "found"
              }
            ]
          }
        }
      }
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "dart"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "mcp__web__search",
              "arguments": {
                "query": "dart"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "Нашёл."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientCapabilities": {
            "fs": {
              "readTextFile": true,
              "writeTextFile": true
            },
            "terminal": true
          },
          "clientInfo": {
            "name": "fixture-client",
            "version": "0.0.0"
          }
        }
      },
      "note": "клиент объявляет fs и terminal и запрашивает версию 1"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": 0,
        "result": {
          "$partial": {
            "protocolVersion": 1
          }
        }
      },
      "note": "ответ initialize; mcpCapabilities проверяет acp/initialize-capabilities"
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "${cwd}",
          "mcpServers": [
            {
              "type": "http",
              "name": "web",
              "url": "https://web.mcp.test/mcp",
              "headers": []
            },
            {
              "type": "sse",
              "name": "old",
              "url": "https://old.mcp.test/sse",
              "headers": []
            },
            {
              "type": "websocket",
              "name": "future",
              "url": "wss://future.mcp.test/ws"
            }
          ]
        }
      },
      "note": "клиент создаёт сессию с MCP-серверами"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "$partial": {
            "sessionId": {
              "$capture": "sessionId"
            }
          }
        }
      },
      "note": "ответ ждёт подключения серверов (ACP-8): уведомлений до него нет"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "$partial": {
              "sessionUpdate": "available_commands_update"
            }
          }
        }
      },
      "optional": true
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Найди dart"
            }
          ]
        }
      },
      "note": "пользователь отправляет промпт"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": "mcp__web__search",
            "kind": "other",
            "status": "pending",
            "rawInput": {
              "query": "dart"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "permId"
        },
        "method": "session/request_permission",
        "params": {
          "sessionId": "${sessionId}",
          "toolCall": {
            "toolCallId": "call_1",
            "title": "mcp__web__search",
            "kind": "other",
            "status": "pending",
            "rawInput": {
              "query": "dart"
            }
          },
          "options": [
            {
              "optionId": {
                "$capture": "permAllowOnce"
              },
              "name": {
                "$any": true
              },
              "kind": "allow_once"
            },
            {
              "optionId": {
                "$capture": "permAllowAlways"
              },
              "name": {
                "$any": true
              },
              "kind": "allow_always"
            },
            {
              "optionId": {
                "$capture": "permRejectOnce"
              },
              "name": {
                "$any": true
              },
              "kind": "reject_once"
            },
            {
              "optionId": {
                "$capture": "permRejectAlways"
              },
              "name": {
                "$any": true
              },
              "kind": "reject_always"
            }
          ]
        }
      },
      "note": "запрос разрешения идёт до обращения к MCP-серверу (P-01)"
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${permId}",
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "${permAllowOnce}"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "in_progress"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "completed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "found"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Нашёл."
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "note": "агент может назвать сессию после первого хода",
      "optional": true
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      },
      "note": "ответ последним кадром хода (ACP-3)"
    }
  ],
  "after": {
    "mcpCalls": {
      "web": [
        {
          "name": "search",
          "arguments": {
            "query": "dart"
          }
        }
      ]
    }
  }
}
