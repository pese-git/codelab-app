{
  "id": "acp/prompt-provider-error",
  "spec": [
    "05-Prompt Turn.md#stop-reasons",
    "01-Overview.md#error-handling"
  ],
  "description": "Провайдер отвечает ошибкой сервера; ответ на session/prompt — -32603 с data.codelab: errorClass server, retryable true — повтор того же хода может пройти.",
  "extensions": [
    "errorData"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard"
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "error": {
          "class": "server",
          "message": "503 Service Unavailable"
        }
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Привет"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "error": {
          "code": -32603,
          "message": {
            "$contains": "Turn failed"
          },
          "data": {
            "codelab": {
              "errorClass": "server",
              "message": "503 Service Unavailable",
              "retryable": true
            }
          }
        }
      }
    }
  ]
}
