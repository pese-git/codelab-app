  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768,
      "cost": {
        "input": 3,
        "output": 15,
        "cacheRead": 0.3,
        "cacheWrite": 3.75
      }
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "Ещё"
          }
        },
        "reply": [
          {
            "text": "Вот ответ."
          }
        ],
        "stopReason": "stop",
        "usage": {
          "input": 100,
          "output": 50
        }
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "loadId"
        },
        "method": "session/load",
        "params": {
          "sessionId": "01JB8Q2W6R9T3M5K7N1P4X8Z0C",
          "cwd": "${cwd}",
          "mcpServers": []
