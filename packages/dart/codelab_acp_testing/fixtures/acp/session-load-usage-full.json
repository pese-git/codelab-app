            "content": [
              {
                "type": "text",
                "text": "Расскажи ещё"
              }
            ],
            "timestamp": "2026-10-25T10:00:03.000Z"
          }
        },
        {
          "type": "message",
          "id": "r4",
          "parentId": "r3",
          "timestamp": "2026-10-25T10:00:04.000Z",
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Вот рассказ."
              }
            ],
            "model": {
              "provider": "scripted",
              "id": "scripted-1"
