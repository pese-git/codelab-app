{
  "id": "acp/prompt-usage-unpriced",
  "spec": [
    "15-Extensibility.md#custom-notifications",
    "15-Extensibility.md#advertising-custom-capabilities",
    "05-Prompt Turn.md#4-check-for-completion"
  ],
  "description": "Модель без цен и шаг без usage (D6): шаг 0 — токены без цен (partial noPrice, cost и currency нет), шаг 1 — ответ модели без usage (partial noUsage, нулевые токены). Ход и сессия — объединение причин в порядке таблицы D6: noUsage, noPrice.",
  "goals": [
    "L-11"
  ],
  "extensions": [
    "task",
    "usage"
  ],
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "clientCapabilities": {
      "fs": {
        "readTextFile": true,
        "writeTextFile": true
      },
      "terminal": true,
      "_meta": {
        "codelab": {
          "usage": {
            "version": 1
          }
        }
      }
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "список"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "task_create",
              "arguments": {
                "subject": "Прочитать тесты",
                "priority": "high"
              }
            }
          }
        ],
        "stopReason": "toolUse",
        "usage": {
          "input": 500,
          "output": 100
        }
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "Готово."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Составь список задач для исправления теста"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": "Create task",
            "kind": "think",
            "status": "pending",
            "rawInput": {
              "subject": "Прочитать тесты",
              "priority": "high"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "in_progress"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "plan",
            "entries": [
              {
                "content": "Прочитать тесты",
                "priority": "high",
                "status": "pending",
                "_meta": {
                  "codelab": {
                    "task": {
                      "id": "1",
                      "owner": "main",
                      "blockedBy": []
                    }
                  }
                }
              }
            ],
            "_meta": {
              "codelab": {
                "taskChange": {
                  "op": "create",
                  "actor": "main",
                  "toolCallId": "call_1",
                  "changed": [
                    "1"
                  ],
                  "deleted": []
                }
              }
            }
          }
        }
      },
      "note": "план целиком; TaskListChanged приходит до завершения вызова (TSK-1)"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "completed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "Created task #1"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "_codelab/session/usage",
        "params": {
          "sessionId": "${sessionId}",
          "seq": 1,
          "trigger": "step",
          "turnId": {
            "$capture": "turnId"
          },
          "step": {
            "index": 0,
            "model": "scripted/scripted-1",
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noPrice"
            ]
          },
          "turn": {
            "steps": 1,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noPrice"
            ]
          },
          "session": {
            "turns": 1,
            "steps": 1,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noPrice"
            ]
          },
          "context": {
            "used": {
              "$any": true
            },
            "size": 32768,
            "compactAt": 24576
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Готово."
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "_codelab/session/usage",
        "params": {
          "sessionId": "${sessionId}",
          "seq": 2,
          "trigger": "step",
          "turnId": "${turnId}",
          "step": {
            "index": 1,
            "model": "scripted/scripted-1",
            "tokens": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noUsage"
            ]
          },
          "turn": {
            "steps": 2,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noUsage",
              "noPrice"
            ]
          },
          "session": {
            "turns": 1,
            "steps": 2,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noUsage",
              "noPrice"
            ]
          },
          "context": {
            "used": {
              "$any": true
            },
            "size": 32768,
            "compactAt": 24576
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "_codelab/session/usage",
        "params": {
          "sessionId": "${sessionId}",
          "seq": 3,
          "trigger": "turn",
          "turnId": "${turnId}",
          "turn": {
            "steps": 2,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noUsage",
              "noPrice"
            ]
          },
          "session": {
            "turns": 1,
            "steps": 2,
            "tokens": {
              "input": 500,
              "output": 100,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "partial": [
              "noUsage",
              "noPrice"
            ]
          },
          "context": {
            "used": {
              "$any": true
            },
            "size": 32768,
            "compactAt": 24576
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
