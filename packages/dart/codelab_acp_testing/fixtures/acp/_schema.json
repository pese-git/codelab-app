{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelab.local/codelab_acp_testing/fixtures/acp/_schema.json",
  "title": "Golden ACP fixture",
  "description": "Format of a golden ACP fixture: docs/architecture/proposals/agent-core/14-golden-fixtures.md §14.4. The loader (lib/src/fixtures/fixture.dart) checks the same structure; fixtures_schema_sync_test.dart keeps both in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "spec", "description", "setup", "frames"],
  "properties": {
    "id": {
      "description": "acp/<file name without .json>.",
      "type": "string",
      "pattern": "^acp/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "spec": {
      "description": "References relative to docs/acp/protocol/: \"<file>.md#<anchor>\".",
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "description": {"type": "string"},
    "goals": {
      "description": "Parity goal ids (agent-parity-goals.md).",
      "type": "array",
      "items": {"type": "string"}
    },
    "extensions": {
      "description": "ACP extensions the fixture uses (§13.12).",
      "type": "array",
      "items": {"type": "string"}
    },
    "roles": {
      "type": "array",
      "items": {"enum": ["agent", "client"]},
      "minItems": 1,
      "uniqueItems": true,
      "default": ["agent", "client"]
    },
    "setup": {"$ref": "#/$defs/setup"},
    "llm": {"$ref": "#/$defs/llm"},
    "frames": {
      "type": "array",
      "items": {"$ref": "#/$defs/frame"},
      "minItems": 1
    },
    "normalize": {"$ref": "#/$defs/normalize"},
    "after": {"$ref": "#/$defs/after"}
  },
  "$defs": {
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cwd": {"type": "string", "default": "/work/fixture"},
        "files": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "profile": {"type": "string", "default": "agent-serve"},
        "mode": {"type": "string", "default": "standard"},
        "config": {"type": "object"},
        "clientCapabilities": {"type": "object"},
        "terminal": {
          "description": "Client run only: scripted processes of the fake terminal port, keyed by the command line.",
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/terminalCommand"}
        },
        "web": {
          "description": "After MVP: fake HTTP answers keyed by URL (§17.1.10).",
          "type": "object"
        },
        "skipInitialize": {"type": "boolean", "default": false},
        "sessions": {
          "description": "Agent run only: journals of sessions before the scenario, session id -> journal records; the first record is the session header (agent-core §8.2).",
          "type": "object",
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        },
        "transport": {"$ref": "#/$defs/transport"}
      }
    },
    "transport": {
      "description": "Transport fixture: frames go over stdio or WebSocket of the binary process, played by the transport driver; the in-memory agent run skips it (change add-codelab-agent-binary, D8).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["stdio", "ws"]},
        "attempts": {
          "description": "ws only: upgrade attempts before the main connection, in order.",
          "type": "array",
          "items": {"$ref": "#/$defs/transportAttempt"}
        }
      }
    },
    "transportAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization", "expectStatus"],
      "properties": {
        "authorization": {"enum": ["none", "wrong", "valid"]},
        "expectStatus": {"type": "integer"}
      }
    },
    "terminalCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {"type": "string"},
        "exitCode": {"type": "integer"}
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dir"],
      "oneOf": [{"required": ["frame"]}, {"required": ["unordered"]}],
      "properties": {
        "dir": {"enum": ["c2a", "a2c"]},
        "frame": {"type": "object"},
        "unordered": {
          "type": "array",
          "items": {"type": "object"},
          "minItems": 1
        },
        "note": {"type": "string"},
        "optional": {"type": "boolean"},
        "repeat": {"const": "+"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$text"],
          "properties": {"$text": {"type": "string"}}
        }
      },
      "dependentRequired": {"match": ["repeat"]}
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "model": {"$ref": "#/$defs/llmModel"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/llmStep"}}
      }
    },
    "llmModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string"},
        "modelId": {"type": "string"},
        "contextWindow": {"type": "integer"}
      }
    },
    "llmStep": {
      "type": "object",
      "additionalProperties": false,
      "not": {"required": ["reply", "error"]},
      "properties": {
        "expect": {"type": "object"},
        "reply": {"type": "array", "items": {"$ref": "#/$defs/llmReplyBlock"}},
        "stopReason": {"enum": ["stop", "toolUse", "length", "error", "aborted"]},
        "error": {"$ref": "#/$defs/llmError"},
        "delayMs": {"type": "integer"},
        "waitForCancel": {"type": "boolean"},
        "usage": {"type": "object"}
      }
    },
    "llmReplyBlock": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "text": {"type": "string"},
        "thinking": {"type": "string"},
        "toolCall": {"$ref": "#/$defs/llmToolCall"}
      }
    },
    "llmToolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "arguments": {"type": "object"}
      }
    },
    "llmError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "normalize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replace": {"type": "array", "items": {"$ref": "#/$defs/replaceRule"}}
      }
    },
    "replaceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "regex", "with"],
      "properties": {
        "path": {"type": "string", "pattern": "^\\$"},
        "regex": {"type": "string"},
        "with": {"type": "string"}
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    }
  }
}
