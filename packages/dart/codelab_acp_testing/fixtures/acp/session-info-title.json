{
  "id": "acp/session-info-title",
  "spec": [
    "04-Session List.md#updating-session-metadata"
  ],
  "description": "После первого завершённого хода со словами пользователя агент называет сессию: session_info_update с title из промпта и updatedAt приходит до ответа на session/prompt.",
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard"
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "a_test"
          }
        },
        "reply": [
          {
            "text": "Чиню."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Почини тест в a_test.dart"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Чиню."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "автоматический заголовок (agent-core §8.10)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": "Почини тест в a_test.dart",
            "updatedAt": "<ts>"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
