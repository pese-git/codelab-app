{
  "id": "acp/prompt-tool-permission-reject-continues",
  "spec": [
    "08-Tool Calls.md#requesting-permission",
    "08-Tool Calls.md#permission-options",
    "08-Tool Calls.md#status",
    "05-Prompt Turn.md#6-continue-conversation",
    "05-Prompt Turn.md#stop-reasons",
    "09-File System.md#reading-files"
  ],
  "description": "Модель правит файл; пользователь отвечает reject_once; вызов завершается failed с причиной отказа, файл не меняется, модель получает результат-ошибку и продолжает ход текстом; ход завершается end_turn, а не cancelled. Ожидаемые кадры не пишут _meta.codelab: _meta сравнивается как $partial.",
  "goals": [
    "P-04"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "files": {
      "README.md": "# foo\n"
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "README"
          }
        },
        "reply": [
          {
            "text": "Заменю слово."
          },
          {
            "toolCall": {
              "id": "call_1",
              "name": "edit",
              "arguments": {
                "path": "README.md",
                "oldText": "foo",
                "newText": "bar"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": true
          }
        },
        "reply": [
          {
            "text": "Хорошо, оставлю файл без изменений."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "пользователь отправляет промпт",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Замени в README.md слово foo на bar"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Заменю слово."
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "read1"
        },
        "method": "fs/read_text_file",
        "params": {
          "sessionId": "${sessionId}",
          "path": "${cwd}/README.md"
        }
      },
      "note": "present() строит diff для запроса разрешения"
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${read1}",
        "result": {
          "content": "# foo\n"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md",
                "line": 1
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "permId"
        },
        "method": "session/request_permission",
        "params": {
          "sessionId": "${sessionId}",
          "toolCall": {
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md",
                "line": 1
              }
            ],
            "content": [
              {
                "type": "diff",
                "path": "${cwd}/README.md",
                "oldText": "# foo\n",
                "newText": "# bar\n"
              }
            ]
          },
          "options": [
            {
              "optionId": {
                "$capture": "permAllowOnce"
              },
              "name": {
                "$any": true
              },
              "kind": "allow_once"
            },
            {
              "optionId": {
                "$capture": "permAllowAlways"
              },
              "name": {
                "$contains": "README.md"
              },
              "kind": "allow_always"
            },
            {
              "optionId": {
                "$capture": "permRejectOnce"
              },
              "name": {
                "$any": true
              },
              "kind": "reject_once"
            },
            {
              "optionId": {
                "$capture": "permRejectAlways"
              },
              "name": {
                "$contains": "README.md"
              },
              "kind": "reject_always"
            }
          ]
        }
      },
      "note": "запрос разрешения: rawInput, locations и diff обязательны (P-02, PERM-6)"
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${permId}",
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "${permRejectOnce}"
          }
        }
      },
      "note": "пользователь выбирает «отклонить»"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "failed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$any": "The user rejected the tool call."
                  }
                }
              }
            ]
          }
        }
      },
      "note": "отказ — failed с причиной; in_progress не отправляется"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "note": "модель получила результат-ошибку и продолжила ход",
      "repeat": "+",
      "match": {
        "$text": "Хорошо, оставлю файл без изменений."
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "note": "агент может назвать сессию после первого хода",
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ],
  "after": {
    "files": {
      "README.md": "# foo\n"
    }
  }
}
