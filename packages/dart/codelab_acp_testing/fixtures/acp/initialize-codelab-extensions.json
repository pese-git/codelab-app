{
  "id": "acp/initialize-codelab-extensions",
  "spec": [
    "02-Initialization.md#client-capabilities",
    "02-Initialization.md#agent-capabilities",
    "15-Extensibility.md#advertising-custom-capabilities",
    "15-Extensibility.md#the-_meta-field"
  ],
  "description": "Редакция итерации 2 (change add-subagents-and-tasks, задача 2.8a): клиент CodeLab объявляет в clientCapabilities._meta.codelab расширения tasks и subagents (subagentToolCalls клиент добавит с итерации 5); агент с включёнными субагентами (subagents.enabled, max_depth 3 по умолчанию) отвечает теми же полями, что в acp/initialize-capabilities, и блоком agentCapabilities._meta.codelab {subagents: {version: 1, maxDepth: 3}, tasks: {version: 1}} без subagentToolCalls: вызовы потомков адаптер ещё не проецирует (D9, D36 Т12, D37).",
  "goals": [
    "C-20",
    "C-05"
  ],
  "extensions": [
    "capabilities"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "skipInitialize": true
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "клиент объявляет fs, terminal и расширения CodeLab tasks и subagents (D9)",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "initializeId"
        },
        "method": "initialize",
        "params": {
          "$partial": {
            "protocolVersion": 1,
            "clientCapabilities": {
              "fs": {
                "readTextFile": true,
                "writeTextFile": true
              },
              "terminal": true,
              "_meta": {
                "codelab": {
                  "tasks": {
                    "version": 1
                  },
                  "subagents": {
                    "version": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ — как в acp/initialize-capabilities плюс блок объявлений агента: subagents с maxDepth из применённого конфига (D37), без subagentToolCalls (Т12)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${initializeId}",
        "result": {
          "protocolVersion": 1,
          "agentCapabilities": {
            "loadSession": true,
            "promptCapabilities": {
              "image": true,
              "audio": false,
              "embeddedContext": true
            },
            "mcpCapabilities": {
              "http": true,
              "sse": false
            },
            "sessionCapabilities": {
              "list": {}
            },
            "_meta": {
              "codelab": {
                "subagents": {
                  "version": 1,
                  "maxDepth": 3
                },
                "tasks": {
                  "version": 1
                }
              }
            }
          },
          "agentInfo": {
            "name": "codelab-agent",
            "title": "CodeLab Agent",
            "version": {
              "$any": "0.1.0"
            }
          },
          "authMethods": []
        }
      }
    }
  ]
}
