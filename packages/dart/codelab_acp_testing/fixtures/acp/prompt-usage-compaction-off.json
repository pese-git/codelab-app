{
  "id": "acp/prompt-usage-compaction-off",
  "spec": [
    "15-Extensibility.md#custom-notifications",
    "15-Extensibility.md#advertising-custom-capabilities",
    "05-Prompt Turn.md#4-check-for-completion"
  ],
  "description": "Автосжатие выключено (setup.config.compaction.enabled: false; change add-usage-extension, D5, Q10): оценщик заполнения у цикла есть всегда, поэтому context содержит used и size, но не compactAt (поле отсутствует, если порога нет).",
  "goals": [
    "L-11"
  ],
  "extensions": [
    "usage"
  ],
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "clientCapabilities": {
      "fs": {
        "readTextFile": true,
        "writeTextFile": true
      },
      "terminal": true,
      "_meta": {
        "codelab": {
          "usage": {
            "version": 1
          }
        }
      }
    },
    "config": {
      "compaction": {
        "enabled": false
      }
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768,
      "cost": {
        "input": 3,
        "output": 15,
        "cacheRead": 0.3,
        "cacheWrite": 3.75
      }
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "Привет"
          }
        },
        "reply": [
          {
            "text": "Привет! Чем помочь?"
          }
        ],
        "stopReason": "stop",
        "usage": {
          "input": 1000,
          "output": 200
        }
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Привет"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Привет! Чем помочь?"
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "_codelab/session/usage",
        "params": {
          "sessionId": "${sessionId}",
          "seq": 1,
          "trigger": "step",
          "turnId": {
            "$capture": "turnId"
          },
          "step": {
            "index": 0,
            "model": "scripted/scripted-1",
            "tokens": {
              "input": 1000,
              "output": 200,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "cost": "0.006"
          },
          "turn": {
            "steps": 1,
            "tokens": {
              "input": 1000,
              "output": 200,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "cost": "0.006"
          },
          "session": {
            "turns": 1,
            "steps": 1,
            "tokens": {
              "input": 1000,
              "output": 200,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "cost": "0.006"
          },
          "currency": "USD",
          "context": {
            "used": 1200,
            "size": 32768
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "_codelab/session/usage",
        "params": {
          "sessionId": "${sessionId}",
          "seq": 2,
          "trigger": "turn",
          "turnId": "${turnId}",
          "turn": {
            "steps": 1,
            "tokens": {
              "input": 1000,
              "output": 200,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "cost": "0.006"
          },
          "session": {
            "turns": 1,
            "steps": 1,
            "tokens": {
              "input": 1000,
              "output": 200,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "cost": "0.006"
          },
          "currency": "USD",
          "context": {
            "used": 1200,
            "size": 32768
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
