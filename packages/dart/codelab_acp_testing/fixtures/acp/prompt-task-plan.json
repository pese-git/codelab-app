{
  "id": "acp/prompt-task-plan",
  "spec": [
    "11-Agent Plan.md#creating-plans",
    "11-Agent Plan.md#plan-entries",
    "11-Agent Plan.md#updating-plans",
    "15-Extensibility.md#the-_meta-field"
  ],
  "description": "Модель три раза вызывает task_create, затем task_update первого пункта в completed и task_list; агент присылает четыре plan, каждый со всем списком на момент операции и _meta.codelab.task (id, owner, blockedBy) у каждой entry и _meta.codelab.taskChange (op, actor, toolCallId своего вызова, changed, deleted) у самого plan; после task_list нового plan нет; ход завершается end_turn.",
  "goals": [
    "C-20",
    "C-05"
  ],
  "extensions": [
    "task"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard"
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "список задач"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "task_create",
              "arguments": {
                "subject": "Прочитать тесты",
                "priority": "high"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": false
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_2",
              "name": "task_create",
              "arguments": {
                "subject": "Исправить ошибку",
                "priority": "high"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_2",
            "isError": false
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_3",
              "name": "task_create",
              "arguments": {
                "subject": "Запустить тесты",
                "priority": "medium"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_3",
            "isError": false
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_4",
              "name": "task_update",
              "arguments": {
                "id": "1",
                "status": "completed"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_4",
            "isError": false
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_5",
              "name": "task_list",
              "arguments": {}
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_5",
            "isError": false
          }
        },
        "reply": [
          {
            "text": "Список готов."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "пользователь просит составить список задач",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Составь список задач для исправления теста"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": "Create task",
            "kind": "think",
            "status": "pending",
            "rawInput": {
              "subject": "Прочитать тесты",
              "priority": "high"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "in_progress"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "plan",
            "entries": [
              {
                "content": "Прочитать тесты",
                "priority": "high",
                "status": "pending",
                "_meta": {
                  "codelab": {
                    "task": {
                      "id": "1",
                      "owner": "main",
                      "blockedBy": []
                    }
                  }
                }
              }
            ],
            "_meta": {
              "codelab": {
                "taskChange": {
                  "op": "create",
                  "actor": "main",
                  "toolCallId": "call_1",
                  "changed": [
                    "1"
                  ],
                  "deleted": []
                }
              }
            }
          }
        }
      },
      "note": "план целиком; TaskListChanged приходит до завершения вызова (TSK-1)"
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "completed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "Created task #1"
                  }
                }
              }
            ]
          }
        }
      }
    },
