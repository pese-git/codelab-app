{
  "id": "acp/set-mode-plan-rejects-edit",
  "spec": [
    "12-Session Model.md#from-the-client",
    "08-Tool Calls.md#status"
  ],
  "description": "После session/set_mode plan правка отклоняется без вопроса: вызов failed с _meta.codelab.outcome rejected и причиной plan mode для модели, файл не меняется, ход продолжается.",
  "extensions": [
    "outcome"
  ],
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "files": {
      "README.md": "# foo\n"
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "README"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "edit",
              "arguments": {
                "path": "README.md",
                "oldText": "foo",
                "newText": "bar"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": true
          }
        },
        "reply": [
          {
            "text": "Только план."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/set_mode",
        "params": {
          "sessionId": "${sessionId}",
          "modeId": "plan"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "current_mode_update",
            "currentModeId": "plan"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {}
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Замени foo на bar в README.md"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "read1"
        },
        "method": "fs/read_text_file",
        "params": {
          "$partial": {
            "sessionId": "${sessionId}",
            "path": "${cwd}/README.md"
          }
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${read1}",
        "result": {
          "content": "# foo\n"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md",
                "line": 1
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "plan запрещает правки (agent-core §13.6)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "failed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "plan mode"
                  }
                }
              }
            ],
            "_meta": {
              "codelab": {
                "outcome": "rejected"
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Только план."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ],
  "after": {
    "files": {
      "README.md": "# foo\n"
    }
  }
}
