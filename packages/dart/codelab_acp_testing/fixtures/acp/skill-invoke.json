{
  "id": "acp/skill-invoke",
  "spec": [
    "14-Slash Commands.md#running-commands",
    "14-Slash Commands.md#advertising-commands",
    "03-Session Setup.md#loading-a-session"
  ],
  "description": "Навык release-notes (шаблон $1, $2): промпт «/skill:release-notes v1.2 v1.3» доходит до scripted-модели сообщением пользователя с блоком навыка и подставленными аргументами (invoked.md); после session/load реплей содержит user_message_chunk с исходной командой; «/skill:nope» даёт один agent_message_chunk «Unknown skill: nope. Run /help to list commands.» и end_turn без запроса к модели (E-06; design.md change add-agent-skills, D8). Порядок: вызов, загрузка сессии, неизвестный навык — фикстура проверяет и ветку skill: в загруженной сессии; ответ «Unknown skill» в журнал не пишется (R-08).",
  "goals": [
    "E-06"
  ],
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "skipInitialize": true,
    "files": {
      ".codelab/skills/release-notes/SKILL.md": "---\nname: release-notes\ndescription: Draft release notes from two git tags\nargument-hint: \"<from> <to>\"\n---\nSummarize the changes from $1 to $2.\n"
    },
    "config": {
      "trusted_projects": [
        "${cwd}"
      ]
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "/.codelab/skills/release-notes\">\nSummarize the changes from v1.2 to v1.3."
          }
        },
        "reply": [
          {
            "text": "Готово."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "клиент объявляет fs и terminal и запрашивает версию 1",
      "frame": {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "initialize",
        "params": {
          "protocolVersion": 1,
          "clientCapabilities": {
            "fs": {
              "readTextFile": true,
              "writeTextFile": true
            },
            "terminal": true
          },
          "clientInfo": {
            "name": "fixture-client",
            "version": "0.0.0"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ initialize; поля проверяет acp/initialize-capabilities",
      "frame": {
        "jsonrpc": "2.0",
        "id": 0,
        "result": {
          "$partial": {
            "protocolVersion": 1
          }
        }
      }
    },
    {
      "dir": "c2a",
      "note": "клиент создаёт сессию в доверенном проекте с навыками из .codelab/skills",
      "frame": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session/new",
        "params": {
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ session/new; команды идут отдельным кадром после него (ACP-8)",
      "frame": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "$partial": {
            "sessionId": {
              "$capture": "sessionId"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "D8: команда навыка после встроенных",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": [
              {
                "name": "compact",
                "description": "Compact the session history",
                "input": {
                  "hint": "[focus]"
                }
              },
              {
                "name": "mode",
                "description": "Switch the session mode",
                "input": {
                  "hint": "plan | ask | standard | accept-edits | bypass"
                }
              },
              {
                "name": "model",
                "description": "Switch the model",
                "input": {
                  "hint": "provider/model"
                }
              },
              {
                "name": "status",
                "description": "Show the model, mode, working directory and MCP servers"
              },
              {
                "name": "mcp",
                "description": "List, reload, enable or disable MCP servers",
                "input": {
                  "hint": "list | reload [<id>] | enable <id> | disable <id>"
                }
              },
              {
                "name": "help",
                "description": "List commands"
              },
              {
                "name": "skill:release-notes",
                "description": "Draft release notes from two git tags",
                "input": {
                  "hint": "<from> <to>"
                }
              }
            ]
          }
        }
      }
    },
    {
      "dir": "c2a",
      "note": "пользователь запускает навык с аргументами",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "/skill:release-notes v1.2 v1.3"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Готово."
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    },
    {
      "dir": "c2a",
      "note": "клиент загружает сессию заново",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "loadId"
        },
        "method": "session/load",
        "params": {
          "sessionId": "${sessionId}",
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "note": "реплей: исходный текст команды навыка, а не обёртка invoked.md с телом",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "user_message_chunk",
            "content": {
              "type": "text",
              "text": "/skill:release-notes v1.2 v1.3"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Готово."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "current_mode_update",
            "currentModeId": "standard"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "config_option_update",
            "configOptions": {
              "$any": []
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "в реплее тот же список на прежнем месте",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": [
              {
                "name": "compact",
                "description": "Compact the session history",
                "input": {
                  "hint": "[focus]"
                }
              },
              {
                "name": "mode",
                "description": "Switch the session mode",
                "input": {
                  "hint": "plan | ask | standard | accept-edits | bypass"
                }
              },
              {
                "name": "model",
                "description": "Switch the model",
                "input": {
                  "hint": "provider/model"
                }
              },
              {
                "name": "status",
                "description": "Show the model, mode, working directory and MCP servers"
              },
              {
                "name": "mcp",
                "description": "List, reload, enable or disable MCP servers",
                "input": {
                  "hint": "list | reload [<id>] | enable <id> | disable <id>"
                }
              },
              {
                "name": "help",
                "description": "List commands"
              },
              {
                "name": "skill:release-notes",
                "description": "Draft release notes from two git tags",
                "input": {
                  "hint": "<from> <to>"
                }
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ session/load — после реплея (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${loadId}",
        "result": {
          "modes": {
            "$any": {
              "availableModes": [
                {
                  "id": "standard",
                  "name": "Standard"
                }
              ],
              "currentModeId": "standard"
            }
          },
          "configOptions": {
            "$any": []
          }
        }
      }
    },
    {
      "dir": "c2a",
      "note": "неизвестный навык: слово после skill: подходит под разбор, но навыка нет (D8)",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "nopeId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "/skill:nope"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "note": "текстовый ответ, а не ошибка протокола; запроса к scripted-модели нет (сверяет verify() — шаг всего один)",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Unknown skill: nope. Run /help to list commands."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "end_turn; запросов к scripted-модели нет",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${nopeId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
