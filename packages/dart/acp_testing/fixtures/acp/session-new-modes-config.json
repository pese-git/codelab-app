{
  "id": "acp/session-new-modes-config",
  "spec": [
    "03-Session Setup.md#creating-a-session",
    "03-Session Setup.md#working-directory",
    "13-Session Config Options.md#initial-state",
    "13-Session Config Options.md#option-ordering",
    "13-Session Config Options.md#relationship-to-session-modes",
    "14-Slash Commands.md#advertising-commands"
  ],
  "description": "После initialize клиент создаёт сессию с абсолютным cwd и без MCP-серверов; агент отвечает sessionId, режимами (modes) и configOptions mode и model в порядке важности, затем после ответа присылает available_commands_update.",
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "skipInitialize": true,
    "config": {
      "agent": {
        "default_model": "scripted/scripted-1"
      }
    }
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "клиент объявляет fs и terminal и запрашивает версию 1",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "initializeId"
        },
        "method": "initialize",
        "params": {
          "$partial": {
            "protocolVersion": 1,
            "clientCapabilities": {
              "fs": {
                "readTextFile": true,
                "writeTextFile": true
              },
              "terminal": true
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ответ агента — ровно эти поля (agent-core §13.2)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${initializeId}",
        "result": {
          "protocolVersion": 1,
          "agentCapabilities": {
            "loadSession": true,
            "promptCapabilities": {
              "image": true,
              "audio": false,
              "embeddedContext": true
            },
            "mcpCapabilities": {
              "http": false,
              "sse": false
            },
            "sessionCapabilities": {
              "list": {}
            }
          },
          "agentInfo": {
            "name": "codelab-agent",
            "title": "CodeLab Agent",
            "version": {
              "$any": "0.1.0"
            }
          },
          "authMethods": []
        }
      }
    },
    {
      "dir": "c2a",
      "note": "клиент создаёт сессию без MCP-серверов",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "sessionNewId"
        },
        "method": "session/new",
        "params": {
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "note": "режимы для совместимости и configOptions — основной канал (agent-core §13.4)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${sessionNewId}",
        "result": {
          "sessionId": {
            "$capture": "sessionId"
          },
          "modes": {
            "currentModeId": "standard",
            "availableModes": [
              {
                "id": "plan",
                "name": "Plan",
                "description": "Read and plan only, no changes"
              },
              {
                "id": "ask",
                "name": "Ask",
                "description": "Approve every call, including reads"
              },
              {
                "id": "standard",
                "name": "Standard",
                "description": "Reads without asking, edits and commands with approval"
              },
              {
                "id": "accept-edits",
                "name": "Accept edits",
                "description": "Reads and edits without asking, commands and network with approval"
              },
              {
                "id": "bypass",
                "name": "Bypass",
                "description": "No approval except for critical commands, agent config edits and network access"
              }
            ]
          },
          "configOptions": [
            {
              "id": "mode",
              "name": "Mode",
              "category": "mode",
              "type": "select",
              "currentValue": "standard",
              "options": [
                {
                  "value": "plan",
                  "name": "Plan"
                },
                {
                  "value": "ask",
                  "name": "Ask"
                },
                {
                  "value": "standard",
                  "name": "Standard"
                },
                {
                  "value": "accept-edits",
                  "name": "Accept edits"
                },
                {
                  "value": "bypass",
                  "name": "Bypass"
                }
              ]
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/scripted-1",
              "options": [
                {
                  "value": "scripted/scripted-1",
                  "name": "scripted-1"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": {
              "$any": []
            }
          }
        }
      },
      "note": "после ответа session/new (ACP-8); состав списка — фикстуры этапа 8"
    }
  ]
}
