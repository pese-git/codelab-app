{
  "id": "acp/multi-session-concurrent-prompts",
  "spec": [
    "05-Prompt Turn.md#the-prompt-turn-lifecycle",
    "03-Session Setup.md#session-id"
  ],
  "description": "Две сессии одного соединения получают промпты подряд; ходы идут параллельно, уведомления и ответы каждой сессии несут свой sessionId и приходят в любом порядке между сессиями.",
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard"
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "reply": [
          {
            "text": "Готово."
          }
        ],
        "stopReason": "stop"
      },
      {
        "reply": [
          {
            "text": "Готово."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "вторая сессия",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/new",
        "params": {
          "cwd": "${cwd}",
          "mcpServers": []
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "$partial": {
            "sessionId": {
              "$capture": "secondId"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${secondId}",
          "update": {
            "sessionUpdate": "available_commands_update",
            "availableCommands": {
              "$any": []
            }
          }
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Первая"
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "session/prompt",
        "params": {
          "sessionId": "${secondId}",
          "prompt": [
            {
              "type": "text",
              "text": "Вторая"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "note": "ходы двух сессий идут параллельно",
      "unordered": [
        {
          "jsonrpc": "2.0",
          "method": "session/update",
          "params": {
            "sessionId": "${sessionId}",
            "update": {
              "sessionUpdate": "agent_message_chunk",
              "content": {
                "type": "text",
                "text": "Готово."
              }
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "method": "session/update",
          "params": {
            "sessionId": "${sessionId}",
            "update": {
              "sessionUpdate": "session_info_update",
              "title": {
                "$any": "Fixture"
              },
              "updatedAt": "<ts>"
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 3,
          "result": {
            "stopReason": "end_turn"
          }
        },
        {
          "jsonrpc": "2.0",
          "method": "session/update",
          "params": {
            "sessionId": "${secondId}",
            "update": {
              "sessionUpdate": "agent_message_chunk",
              "content": {
                "type": "text",
                "text": "Готово."
              }
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "method": "session/update",
          "params": {
            "sessionId": "${secondId}",
            "update": {
              "sessionUpdate": "session_info_update",
              "title": {
                "$any": "Fixture"
              },
              "updatedAt": "<ts>"
            }
          }
        },
        {
          "jsonrpc": "2.0",
          "id": 4,
          "result": {
            "stopReason": "end_turn"
          }
        }
      ]
    }
  ]
}
