{
  "id": "acp/permission-options-all-four",
  "spec": [
    "08-Tool Calls.md#requesting-permission",
    "08-Tool Calls.md#permission-options"
  ],
  "description": "Правка в режиме standard спрашивается; запрос несёт четыре варианта allow_once, allow_always, reject_once, reject_always, у вариантов «всегда» имя называет шаблон пути; reject_once отклоняет вызов с _meta.codelab.outcome rejected, ход продолжается.",
  "extensions": [
    "outcome"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "files": {
      "README.md": "# foo\n"
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "README"
          }
        },
        "reply": [
          {
            "toolCall": {
              "id": "call_1",
              "name": "edit",
              "arguments": {
                "path": "README.md",
                "oldText": "foo",
                "newText": "bar"
              }
            }
          }
        ],
        "stopReason": "toolUse"
      },
      {
        "expect": {
          "toolResult": {
            "toolCallId": "call_1",
            "isError": true
          }
        },
        "reply": [
          {
            "text": "Не буду."
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Замени foo на bar в README.md"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "read1"
        },
        "method": "fs/read_text_file",
        "params": {
          "$partial": {
            "sessionId": "${sessionId}",
            "path": "${cwd}/README.md"
          }
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${read1}",
        "result": {
          "content": "# foo\n"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md",
                "line": 1
              }
            ]
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "optionId совпадает с kind (agent-core §7.8)",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "permId"
        },
        "method": "session/request_permission",
        "params": {
          "sessionId": "${sessionId}",
          "toolCall": {
            "toolCallId": "call_1",
            "title": {
              "$contains": "README.md"
            },
            "kind": "edit",
            "status": "pending",
            "rawInput": {
              "path": "README.md",
              "oldText": "foo",
              "newText": "bar"
            },
            "locations": [
              {
                "path": "${cwd}/README.md",
                "line": 1
              }
            ],
            "content": [
              {
                "type": "diff",
                "path": "${cwd}/README.md",
                "oldText": "# foo\n",
                "newText": "# bar\n"
              }
            ]
          },
          "options": [
            {
              "optionId": "allow_once",
              "name": "Allow once",
              "kind": "allow_once"
            },
            {
              "optionId": "allow_always",
              "name": "Always allow README.md",
              "kind": "allow_always"
            },
            {
              "optionId": "reject_once",
              "name": "Reject",
              "kind": "reject_once"
            },
            {
              "optionId": "reject_always",
              "name": "Always reject README.md",
              "kind": "reject_always"
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${permId}",
        "result": {
          "outcome": {
            "outcome": "selected",
            "optionId": "reject_once"
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "call_1",
            "status": "failed",
            "content": [
              {
                "type": "content",
                "content": {
                  "type": "text",
                  "text": {
                    "$contains": "rejected"
                  }
                }
              }
            ],
            "_meta": {
              "codelab": {
                "outcome": "rejected"
              }
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Не буду."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ],
  "after": {
    "files": {
      "README.md": "# foo\n"
    }
  }
}
