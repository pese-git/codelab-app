{
  "id": "acp/config-effort-option",
  "spec": [
    "13-Session Config Options.md#setting-a-config-option",
    "13-Session Config Options.md#option-categories"
  ],
  "description": "Опция effort появляется только у модели с рассуждением и сохраняет значение при смене модели; после смены на модель без рассуждения агент один раз сообщает об этом первым agent_message_chunk следующего хода (agent-core §2.12.3).",
  "roles": [
    "agent"
  ],
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard",
    "config": {
      "providers": {
        "scripted": {
          "models": {
            "scripted-1": {},
            "thinker": {
              "reasoning": true
            }
          }
        }
      }
    }
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "Привет"
          }
        },
        "reply": [
          {
            "text": "Привет!"
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session/set_config_option",
        "params": {
          "sessionId": "${sessionId}",
          "configId": "model",
          "value": "scripted/thinker"
        }
      }
    },
    {
      "dir": "a2c",
      "note": "модель с рассуждением: опция effort есть (ACP-10)",
      "frame": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "configOptions": [
            {
              "$partial": {
                "id": "mode",
                "currentValue": "standard"
              }
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/thinker",
              "options": [
                {
                  "value": "scripted/scripted-1",
                  "name": "scripted-1"
                },
                {
                  "value": "scripted/thinker",
                  "name": "thinker"
                }
              ]
            },
            {
              "id": "effort",
              "name": "Reasoning effort",
              "category": "thought_level",
              "type": "select",
              "currentValue": "medium",
              "options": [
                {
                  "value": "low",
                  "name": "Low"
                },
                {
                  "value": "medium",
                  "name": "Medium"
                },
                {
                  "value": "high",
                  "name": "High"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "session/set_config_option",
        "params": {
          "sessionId": "${sessionId}",
          "configId": "effort",
          "value": "high"
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "configOptions": [
            {
              "$partial": {
                "id": "mode",
                "currentValue": "standard"
              }
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/thinker",
              "options": [
                {
                  "value": "scripted/scripted-1",
                  "name": "scripted-1"
                },
                {
                  "value": "scripted/thinker",
                  "name": "thinker"
                }
              ]
            },
            {
              "id": "effort",
              "name": "Reasoning effort",
              "category": "thought_level",
              "type": "select",
              "currentValue": "high",
              "options": [
                {
                  "value": "low",
                  "name": "Low"
                },
                {
                  "value": "medium",
                  "name": "Medium"
                },
                {
                  "value": "high",
                  "name": "High"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "session/set_config_option",
        "params": {
          "sessionId": "${sessionId}",
          "configId": "model",
          "value": "scripted/scripted-1"
        }
      }
    },
    {
      "dir": "a2c",
      "note": "без рассуждения опции нет, значение хранится",
      "frame": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "configOptions": [
            {
              "$partial": {
                "id": "mode",
                "currentValue": "standard"
              }
            },
            {
              "id": "model",
              "name": "Model",
              "category": "model",
              "type": "select",
              "currentValue": "scripted/scripted-1",
              "options": [
                {
                  "value": "scripted/scripted-1",
                  "name": "scripted-1"
                },
                {
                  "value": "scripted/thinker",
                  "name": "thinker"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "dir": "c2a",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Привет"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "note": "заметка о смене модели — одним первым agent_message_chunk, не модели и не в журнал",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Reasoning effort is not supported by scripted/scripted-1; the setting is kept and applies again after switching to a model with reasoning."
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": "Привет!"
            }
          }
        }
      }
    },
    {
      "dir": "a2c",
      "note": "агент может назвать сессию после первого хода",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
