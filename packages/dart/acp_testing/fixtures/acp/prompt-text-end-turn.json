{
  "id": "acp/prompt-text-end-turn",
  "spec": [
    "05-Prompt Turn.md#1-user-message",
    "05-Prompt Turn.md#3-agent-reports-output",
    "05-Prompt Turn.md#4-check-for-completion",
    "05-Prompt Turn.md#stop-reasons"
  ],
  "description": "Пользователь отправляет текстовый промпт; модель отвечает текстом без инструментов; агент стримит agent_message_chunk и завершает ход ответом session/prompt со stopReason end_turn после всех уведомлений.",
  "setup": {
    "cwd": "/work/demo",
    "profile": "agent-serve",
    "mode": "standard"
  },
  "llm": {
    "model": {
      "provider": "scripted",
      "modelId": "scripted-1",
      "contextWindow": 32768
    },
    "steps": [
      {
        "expect": {
          "lastMessage": {
            "role": "user",
            "$textContains": "Привет"
          }
        },
        "reply": [
          {
            "text": "Привет! Чем помочь?"
          }
        ],
        "stopReason": "stop"
      }
    ]
  },
  "frames": [
    {
      "dir": "c2a",
      "note": "пользователь отправляет промпт",
      "frame": {
        "jsonrpc": "2.0",
        "id": {
          "$capture": "promptId"
        },
        "method": "session/prompt",
        "params": {
          "sessionId": "${sessionId}",
          "prompt": [
            {
              "type": "text",
              "text": "Привет"
            }
          ]
        }
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": {
              "type": "text",
              "text": {
                "$any": true
              }
            }
          }
        }
      },
      "repeat": "+",
      "match": {
        "$text": "Привет! Чем помочь?"
      }
    },
    {
      "dir": "a2c",
      "frame": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "${sessionId}",
          "update": {
            "sessionUpdate": "session_info_update",
            "title": {
              "$any": "Fixture"
            },
            "updatedAt": "<ts>"
          }
        }
      },
      "note": "агент может назвать сессию после первого хода",
      "optional": true
    },
    {
      "dir": "a2c",
      "note": "ответ последним кадром хода (ACP-3)",
      "frame": {
        "jsonrpc": "2.0",
        "id": "${promptId}",
        "result": {
          "stopReason": "end_turn"
        }
      }
    }
  ]
}
