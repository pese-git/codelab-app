---
/**
 * Страница документа из репозитория: `/docs/<путь>/`.
 *
 * Почему: документация собирается из файлов репозитория на месте, адрес
 * выводится из пути (design.md add-astro-site, D3, D4); рядом — меню секции
 * (design.md improve-docs-navigation, D4), крошки и «Назад / Далее» (D5),
 * оглавление по `##` и ссылка на исходный файл на GitHub.
 *
 * Меню секции выводится дважды: колонкой от 900 px и свёрнутым `<details>`
 * до 900 px, CSS показывает одну копию (D4). `<article data-pagefind-body>`
 * — единственная индексируемая область страницы (D8).
 *
 * Для чего: одна страница на каждый документ allowlist. Скрипт mermaid
 * подключается только при блоке ```` ```mermaid ```` в исходнике (D7).
 *
 * Как использовать: маршрут строит Astro из `getStaticPaths`; новый документ
 * allowlist получает страницу без правки этого файла.
 */
import { render } from 'astro:content';

import CopyCode from '../../components/docs/CopyCode.astro';
import DocBreadcrumbs from '../../components/docs/DocBreadcrumbs.astro';
import DocPager from '../../components/docs/DocPager.astro';
import DocSearch from '../../components/docs/DocSearch.astro';
import DocSectionNav from '../../components/docs/DocSectionNav.astro';
import TocSpy from '../../components/docs/TocSpy.astro';
import MermaidScript from '../../components/MermaidScript.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbs, buildNav, installDocPath, locateDoc, neighbours } from '../../lib/nav';
import { loadDocs, type SiteDoc } from '../../lib/site-docs';
import { repoUrl, resolveRepoRef } from '../../site.config';

export async function getStaticPaths() {
  const docs = await loadDocs();
  return docs.map((doc) => ({ params: { path: doc.routePath }, props: { doc, docs } }));
}

interface Props {
  readonly doc: SiteDoc;
  readonly docs: readonly SiteDoc[];
}

const { doc, docs } = Astro.props;
const { Content, headings } = await render(doc.entry);
const nav = buildNav(docs);
const base = import.meta.env.BASE_URL;
const section = locateDoc(nav, doc.repoPath)?.section;
// Группа для подписи результата поиска (D8): у пакета — его имя, как в крошках.
const group = section?.layer
  ? section.title
  : (nav.find((candidate) => candidate.sections.some((entry) => entry === section))?.title ?? '');
const crumbs = breadcrumbs(nav, doc.repoPath, base);
const { prev, next } = neighbours(nav, doc.repoPath, base);
const toc = headings.filter((heading) => heading.depth === 2);
// Блок mermaid начинается ограждением из трёх и более обратных кавычек или тильд.
const hasMermaid = /^ {0,3}(`{3,}|~{3,})\s*mermaid\b/m.test(doc.entry.body ?? '');
const sourceUrl = `${repoUrl}/blob/${resolveRepoRef()}/${doc.repoPath}`;
---

<BaseLayout title={doc.title} description={doc.description} current={doc.repoPath === installDocPath ? 'install' : 'docs'}>
  <div class="doc-layout">
    {section && <DocSectionNav section={section} current={doc.repoPath} variant="side" />}
    <div class="doc-main">
      <DocSearch />
      <DocBreadcrumbs crumbs={crumbs} />
      {section && <DocSectionNav section={section} current={doc.repoPath} variant="compact" />}
      <article class="prose" data-pagefind-body data-pagefind-meta={`group:${group}`}>
        <Content />
        <DocPager prev={prev} next={next} />
        <p class="doc-source t2" data-pagefind-ignore>
          <a href={sourceUrl}>Исходный файл на GitHub</a> — <code>{doc.repoPath}</code>
        </p>
      </article>
    </div>
    {
      toc.length > 0 && (
        <nav class="doc-toc" aria-label="На этой странице">
          <p class="doc-toc-title">На этой странице</p>
          <ul>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
  <CopyCode />
  {toc.length > 0 && <TocSpy />}
  {hasMermaid && <MermaidScript />}
</BaseLayout>
