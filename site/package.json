{
  "name": "codelab-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:versions && npm run check && npm run test && npm run build && npm run check:links",
    "check:versions": "node scripts/check-exact-versions.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "astro": "7.4.12",
    "mermaid": "12.3.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vitest": "5.1.1"
  }
}
